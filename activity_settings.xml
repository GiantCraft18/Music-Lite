<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Настройки"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Music Lite v1.2"
        android:textSize="18sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="24dp" />

    <!-- Раздел: О приложении -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📄 О приложении"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#00BCD4"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Music Lite — это стильный и удобный музыкальный плеер для Android. Поддерживает MP3, автоматическое отображение обложек, поиск, избранное и многое другое."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- Раздел: Разработчик -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👨‍💻 Разработчик"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#00BCD4"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GiantCraft"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- Раздел: Ссылки -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔗 Ссылки"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#00BCD4"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvGitHubLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GitHub: GiantCraft18"
        android:textColor="#00FFFF"
        android:textSize="14sp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Назад в меню"
        android:background="#333333"
        android:textColor="#FFFFFF" />

</LinearLayout>