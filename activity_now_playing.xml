<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎵 Now Playing"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <ImageView
        android:id="@+id/ivBigAlbumArt"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="#2A2A2A"
        android:scaleType="centerCrop"
        android:radius="100dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvNowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Название трека"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvNowArtist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Исполнитель"
        android:textSize="16sp"
        android:textColor="#AAAAAA" />

    <SeekBar
        android:id="@+id/seekBarNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnRewindNow"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="⏪"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:radius="28dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnPlayNow"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="▶"
            android:background="#00BCD4"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:radius="32dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnForwardNow"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="⏩"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:radius="28dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnStopNow"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="⏹"
            android:background="#E74C3C"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:radius="28dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Назад в список"
        android:background="#333333"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp" />

</LinearLayout>